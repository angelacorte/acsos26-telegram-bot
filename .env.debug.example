# Template for .env.debug, used by scripts/debug-bot.sh.
# Copy to .env.debug (gitignored) and fill in your own throwaway bot token.
BOT_TOKEN=<token-from-@BotFather>
BOT_USERNAME=<your_test_bot_username>

# Open in every chat: no /start <key> handshake while debugging.
BOT_ACCESS_KEY=
# Rapid-fire testing should not hit the throttle.
BOT_CHAT_COOLDOWN_SECONDS=0
TELEGRAM_GROUP_INVITE_URL=https://telegram.me/+debug
TELEGRAM_STARTUP_GREETING="Debug bot online."

# Service-to-service key between the bot and the local assistant; any value, both sides match.
LLM_API_KEY=debug-local-key
LLM_API_URL=http://localhost:8000/ask

# Reused from .env so /ask works in debug too.
GEMINI_API_KEY=<google-ai-studio-key>
GEMINI_MODEL=gemini-3.5-flash-lite
OLLAMA_ENABLED=false
